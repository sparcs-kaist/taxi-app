# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

default_platform(:android)

platform :android do
  desc "Build an app bundle and upload it to Google Play"
  desc "Track is read from PLAY_TRACK (default: alpha)"
  lane :release do
    track = ENV.fetch("PLAY_TRACK", "alpha")

    # versionCode: minutes since the Unix epoch, so it always increases and
    # never has to be bumped by hand. Stays under Play's 2100000000 limit for
    # thousands of years.
    version_code = Time.now.to_i / 60

    # versionName: VERSION_NAME (manual run input), else the v* tag, else pubspec.yaml.
    ref = ENV["GITHUB_REF_NAME"].to_s
    version_name = ENV["VERSION_NAME"].to_s.strip
    version_name = ref.start_with?("v") ? ref.delete_prefix("v") : nil if version_name.empty?
    if version_name && !version_name.match?(/\A\d+(\.\d+)*\z/)
      UI.user_error!("Invalid version name '#{version_name}', expected something like 1.0.5")
    end

    args = ["flutter build appbundle --release", "--build-number=#{version_code}"]
    args << "--build-name=#{version_name}" if version_name
    UI.message("Building versionCode #{version_code}, versionName #{version_name || '(pubspec)'}")
    sh("cd ../.. && #{args.join(' ')}")

    upload_to_play_store(
      track: track,
      aab: File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__),
      # Production uploads stay as a draft so a person rolls them out from Play Console.
      release_status: track == "production" ? "draft" : "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
